VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Whop payments: CLIENT (public, compiled into the browser bundle) ---
# The Whop page "Get Premium" opens. Safe to expose. Optional — it defaults to
# https://whop.com/gglvlup/gglvlup-premium/ (see src/lib/whop.ts). Set it only
# to point checkout somewhere else. A webhook grants premium after payment.
# VITE_WHOP_CHECKOUT_URL="https://whop.com/gglvlup/gglvlup-premium/"

# --- Whop payments: SERVER ONLY — do NOT prefix these with VITE_ ---
# The frontend must never see these. Set them as Supabase function secrets:
#   supabase secrets set WHOP_WEBHOOK_SECRET=...      # exactly as Whop shows it
#   supabase secrets set WHOP_API_KEY=your-secret-api-key
#   supabase secrets set WHOP_COMPANY_ID=biz_xxx      # optional, company scope
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.)
#
# Testing only — processes webhook events even when the signature fails, so a
# 401 doesn't block wiring up the grant path. Anyone who finds the function URL
# can grant themselves premium while this is on. Unset it as soon as it works:
#   supabase secrets set WHOP_WEBHOOK_ALLOW_UNVERIFIED=true
#   supabase secrets unset WHOP_WEBHOOK_ALLOW_UNVERIFIED
