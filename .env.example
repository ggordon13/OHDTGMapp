VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Whop payments: CLIENT (public, compiled into the browser bundle) ---
# Whop hosted-checkout links. Safe to expose. When set, "Get Premium" sends
# users to Whop (a webhook grants premium after payment). Set both to show a
# Monthly/Yearly picker; set just one for a single plan.
VITE_WHOP_CHECKOUT_URL_MONTHLY="https://whop.com/checkout/your-monthly-plan-id"
VITE_WHOP_CHECKOUT_URL_YEARLY="https://whop.com/checkout/your-yearly-plan-id"
# (Single-plan fallback, optional: VITE_WHOP_CHECKOUT_URL="...")

# --- Whop payments: SERVER ONLY — do NOT prefix these with VITE_ ---
# The frontend must never see these. Set them as Supabase function secrets:
#   supabase secrets set WHOP_WEBHOOK_SECRET=whsec_xxx
#   supabase secrets set WHOP_API_KEY=your-secret-api-key
#   supabase secrets set WHOP_COMPANY_ID=biz_xxx      # optional, company scope
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.)
